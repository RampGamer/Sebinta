{
  "name": "sebinta-desktop",
  "version": "1.8.6",
  "description": "Electron desktop app for Sebinta — same interface as the browser, but cleans Office/PDF locally before upload.",
  "private": true,
  "license": "MIT",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux --mac --win"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.sebinta.desktop",
    "productName": "Sebinta",
    "icon": "build/icon.png",
    "files": [
      "main.js",
      "webview-preload.js",
      "clean/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Network"
    },
    "mac": {
      "target": [{ "target": "zip", "arch": ["x64", "arm64"] }],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "portable"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}

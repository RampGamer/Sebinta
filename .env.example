# Copy this file to ".env" and fill in the values.
# cp .env.example .env

# --- Cloudflare Tunnel (required) ---
# Tunnel token, obtained from the Cloudflare dashboard at:
# Zero Trust -> Networks -> Tunnels -> (your tunnel) -> "Install and run a connector".
# See detailed instructions in README.md.
TUNNEL_TOKEN=

# --- Site-wide password (optional) ---
# If set, any access to the site first shows a password screen.
# If left empty/commented out, the site opens freely to anyone with the tunnel link.
SITE_PASSWORD=

# --- Uploads ---
# Maximum size per file, in megabytes.
MAX_FILE_SIZE_MB=500

# If set (>0), files older than N days are deleted automatically.
# Leave empty/commented out to disable automatic cleanup.
FILE_TTL_DAYS=

# --- Sessions / cookies ---
# Secret used to sign session cookies (site authentication and unlocked pad
# passwords). If left empty, a random secret is generated on startup — but
# that means every session (including the site login) is invalidated
# whenever the container restarts. For production, generate a fixed value,
# for example with:
#   openssl rand -hex 32
COOKIE_SECRET=

# Keep "true" in production (the Cloudflare tunnel always serves over HTTPS).
# Only switch to "false" if testing locally over http:// without the tunnel.
COOKIE_SECURE=true

# Copia este ficheiro para ".env" e preenche os valores.
# cp .env.example .env

# --- Cloudflare Tunnel (obrigatório) ---
# Token do túnel, obtido no dashboard da Cloudflare em:
# Zero Trust -> Networks -> Tunnels -> (o teu túnel) -> "Install and run a connector".
# Ver instruções detalhadas no README.md.
TUNNEL_TOKEN=

# --- Password global do site (opcional) ---
# Se definida, qualquer acesso ao site mostra primeiro um ecrã de password.
# Se ficar vazia/comentada, o site abre livremente para quem tiver o link do túnel.
SITE_PASSWORD=

# --- Uploads ---
# Tamanho máximo por ficheiro, em megabytes.
MAX_FILE_SIZE_MB=500

# Se definido (>0), ficheiros com mais de N dias são apagados automaticamente.
# Deixa vazio/comentado para desativar a limpeza automática.
FILE_TTL_DAYS=

# --- Sessões / cookies ---
# Segredo usado para assinar os cookies de sessão (autenticação do site e
# passwords de pads desbloqueados). Se ficar vazio, é gerado um segredo
# aleatório no arranque — mas isso significa que todas as sessões (incluindo
# o login do site) são invalidadas sempre que o container reinicia. Para
# produção, gera um valor fixo, por exemplo com:
#   openssl rand -hex 32
COOKIE_SECRET=

# Mantém "true" em produção (o túnel da Cloudflare serve sempre em HTTPS).
# Só mudar para "false" se testares localmente em http:// sem o túnel.
COOKIE_SECURE=true
